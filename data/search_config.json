{
  "_comment": "Controls job_discovery.py (deterministic, no AI). `aggregators` finds jobs automatically with no per-company setup - it is the default engine. `sources` is for targeting specific boards/URLs (e.g. Amazon/JPMorgan/Goldman program postings, which have no public API - paste those into sources.seed_urls.urls). The keyword/location/exclude lists below are applied to EVERYTHING pulled.",

  "_keywords_note": "Matched with word boundaries. A hit in the job TITLE passes; otherwise 2+ distinct keywords anywhere are needed. Keep entries specific - avoid bare words like 'intern' or 'data'.",
  "keywords": [
    "software engineer", "software developer", "software development engineer",
    "backend", "back end", "back-end", "full stack", "full-stack", "frontend", "front end",
    "sde", "sde-1", "sde 1", "sde i", "associate software", "software engineer i",
    "graduate engineer", "graduate engineer trainee", "graduate trainee", "new grad",
    "python developer", "java developer", "backend developer", "backend engineer",
    "data scientist", "data science", "data analyst", "analyst data science",
    "machine learning engineer", "ml engineer", "ai engineer", "applied ai",
    "applied scientist", "research engineer", "deep learning", "nlp engineer",
    "platform engineer", "api developer", "technology analyst", "developer intern",
    "engineering intern", "software intern", "summer intern", "apprentice"
  ],
  "locations": ["Gurugram", "Gurgaon", "Bengaluru", "Bangalore", "Hyderabad", "Pune", "Mumbai", "Noida", "Delhi", "Chennai", "India", "Remote"],
  "exclude_keywords": [
    "senior", "sr.", "staff", "principal", "lead", "head of", "director",
    "manager", "architect", "vp ", "chief", "president",
    "gardener", "joiner", "cleaner", "driver", "sales", "retail", "warehouse",
    "nurse", "recruiter", "accountant", "bpo", "voice process", "customer support",
    "content reviewer", "rater"
  ],

  "aggregators": {
    "_comment": "Automatic. themuse/remotive/remoteok/arbeitnow/hn_hiring need no key. adzuna/jooble need a free key in .env (ADZUNA_APP_ID+ADZUNA_APP_KEY, JOOBLE_API_KEY) and auto-skip if unset.",
    "themuse":   { "enabled": true, "pages": 4, "levels": ["Entry Level", "Internship"], "locations": ["India", "Flexible / Remote"] },
    "remotive":  { "enabled": true, "per_search": 50 },
    "remoteok":  { "enabled": true },
    "arbeitnow": { "enabled": true, "pages": 3 },
    "hn_hiring": { "enabled": true },
    "adzuna":    { "enabled": true, "country": "in", "max_days_old": 30, "pages": 3 },
    "jooble":    { "enabled": true, "location": "India", "pages": 2 }
  },

  "sources": {
    "greenhouse": {
      "enabled": true,
      "_comment": "board tokens from boards.greenhouse.io/<token>. Added 2026-09-09 from the 'Somin's Placement' sheet sweep - companies with an India presence and a public Greenhouse board.",
      "boards": [
        "enveritas",
        "singlestore",
        "quberesearchandtechnologies",
        "devrev",
        "project44",
        "asteralabs",
        "tenstorrent"
      ]
    },
    "lever": {
      "enabled": false,
      "_comment": "company slugs from jobs.lever.co/<slug>.",
      "companies": []
    },
    "ashby": {
      "enabled": true,
      "_comment": "org slugs from jobs.ashbyhq.com/<slug>. Added 2026-09-09 from the sheet sweep.",
      "orgs": ["deeter-analytics"]
    },
    "rss": {
      "enabled": false,
      "_comment": "Any RSS/Atom job feed URLs.",
      "feeds": []
    },
    "seed_urls": {
      "enabled": true,
      "_comment": "Paste individual job posting URLs (Amazon SDE I Intern 2027, JPMorgan SEP 2027, Goldman NAP 2027, Deloitte Campus27, LinkedIn/Naukri postings, ...). Fetched, text-extracted and analyzed directly.",
      "_browser_hosts_note": "URLs on these hosts are opened through your logged-in Playwright profile (run `python -m app.main login --url https://www.linkedin.com` once) instead of plain HTTP, so login-walled postings resolve.",
      "browser_hosts": ["linkedin.com", "naukri.com", "glassdoor.com", "glassdoor.co.in", "instahyre.com", "wellfound.com", "hirist.com", "amazon.jobs", "jobs.jpmorgan.com", "jpmc.fa.oraclecloud.com", "goldmansachs.com", "careers.microsoft.com", "usijobs.deloitte.com", "apply.deloitte.com"],
      "_urls_note": "Added 2026-09-03. Amazon SDE I Intern 2027 (India, grad-year 2027) req IDs rotate/close every few weeks - re-check and swap if discover logs a 404. JPMorgan/Goldman/Microsoft/Deloitte deep links sit behind JS/auth-walled portals (Oracle Cloud, Workday) that 403 plain fetchers and rotate requisition IDs; the entries below are the program hubs - open them in a logged-in browser, copy the live India requisition URL, and replace the hub URL here.",
      "urls": [
        "https://www.amazon.jobs/en/jobs/10506481/sde-i-intern-amazon-university-talent-acquisition",
        "https://www.amazon.jobs/en/jobs/10503366/sde-i-intern-amazon-university-talent-acquisition",
        "https://www.amazon.jobs/en/jobs/10490515/sde-i-intern-amazon-university-talent-acquisition",
        "https://www.amazon.jobs/en/jobs/10517567/software-development-engineer-intern-annapurna-labs-2027",
        "https://www.jpmorganchase.com/careers/explore-opportunities/programs/software-engineer-fulltime",
        "https://www.goldmansachs.com/careers/students/programs-and-internships/india/new-analyst-program",
        "https://careers.microsoft.com/v2/global/en/recentgraduate",
        "https://usijobs.deloitte.com/en_US/careersUSI",

        "https://nvidia.wd5.myworkdayjobs.com/en-US/NVIDIAExternalCareerSite/job/NVIDIA-2027-Internships--Software-Engineering_JR2023495",
        "https://www.nvidia.com/en-in/about-nvidia/university-recruiting/",
        "https://www.imc.com/in/careers/students-graduates",
        "https://www.salesforce.com/company/careers/university/",
        "https://www.tower-research.com/open-positions/",
        "https://www.morganstanley.com/people-opportunities/students-graduates",
        "https://www.rubrik.com/company/careers/departments/engineering",
        "https://careers.nutanix.com/en/student-programs/",
        "https://www.arista.com/en/careers/university",
        "https://www.capitalonecareers.com/india",
        "https://www.aboutwayfair.com/careers/early-talent",
        "https://careers.confluent.io/",
        "https://www.zynga.com/jobs/careers/",
        "https://www.flipkartcareers.com/students",
        "https://www.uber.com/us/en/careers/teams/university/",
        "https://careers.icims.com/careers-home/jobs",
        "https://jobs.apple.com/en-in/search?sort=relevance&team=internships-STDNT-INTRN",
        "https://job-boards.greenhouse.io/quberesearchandtechnologies"
      ]
    },
    "html_pages": {
      "enabled": false,
      "_comment": "Generic careers pages scraped with Playwright. Fragile - give a CSS selector for job links.",
      "pages": []
    }
  },

  "limits": {
    "max_jobs_per_source": 120,
    "request_timeout_seconds": 20,
    "user_agent": "job-agent/1.0 (+personal job search automation)"
  }
}
