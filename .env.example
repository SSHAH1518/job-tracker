# Copy this file to .env and adjust. Never commit .env.
# NOTE: there is no Anthropic API key here - Claude Code (your Pro plan) does the
# job evaluation / answer drafting. Python only does deterministic work.

# --- Pipeline thresholds (used by `requeue` to decide the application queue) ---
# Minimum Claude-assigned match_score (0-100) required to enter the queue.
MIN_MATCH_SCORE=75
# Minimum keyword-overlap ratio (0-1) for the cheap discovery-time filter.
MIN_BASIC_MATCH=0.12

# --- Git sync ---
# Set to 1 to let `discover` / `prepare` auto commit+push data/ afterwards.
GIT_AUTO_SYNC=0
GIT_REMOTE=origin
GIT_BRANCH=main
# Seconds to wait for more changes before committing (debounce).
GIT_SYNC_DEBOUNCE=30

# --- Browser ---
# Run Chromium with a visible window (recommended while logging in manually).
BROWSER_HEADLESS=0
# Persistent profile dir keeps you logged into job sites between runs.
BROWSER_PROFILE_DIR=data/browser_profile

# --- Scheduler ---
DISCOVERY_INTERVAL_HOURS=4

# --- Optional aggregator API keys (both free; discovery works without them) ---
# Adzuna: best India coverage. Register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: request a key at https://jooble.org/api/about
JOOBLE_API_KEY=
